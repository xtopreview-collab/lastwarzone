---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides', ({ id }) => id.startsWith('en/'));

const categories = [
  { id: 'combat', icon: '⚔️', name: 'Combat & PvP', desc: 'Damage formulas, squad synergy, PvP strategy' },
  { id: 'heroes', icon: '🦸', name: 'Heroes', desc: 'Tier lists, hero builds, squad compositions' },
  { id: 'buildings', icon: '🏗️', name: 'Base Development', desc: 'HQ progression, Tech Centre, building priority' },
  { id: 'gear', icon: '🛡️', name: 'Gear & Equipment', desc: 'Mythic gear, Exclusive Weapons, upgrade paths' },
  { id: 'resources', icon: '💎', name: 'Resources', desc: 'Gems, packs, VIP, resource management' },
  { id: 'seasons', icon: '🏆', name: 'Seasons & Events', desc: 'VS Duel, SvS, Alliance, event guides' },
  { id: 'decorations', icon: '🏛️', name: 'Decorations', desc: 'Decoration gallery, buffs, tier list' },
];
---

<BaseLayout title="Last War Survival Guide" lang="en">
  <section class="text-center py-12 md:py-20">
    <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-4">
      Last War <span class="text-dark-accent">Zone</span>
    </h1>
    <p class="text-lg md:text-xl text-dark-muted max-w-2xl mx-auto mb-8">
      The ultimate strategy guide for Last War: Survival Game.
      <br />From beginner tips to endgame meta — updated for Season 3.
    </p>
    <a
      href="/en/guides/"
      class="inline-flex items-center gap-2 rounded-xl bg-dark-accent px-6 py-3 text-sm font-bold text-black hover:bg-dark-accent-hover transition-colors"
    >
      📚 Browse Guides
    </a>
  </section>

  <section class="py-8">
    <h2 class="text-2xl font-bold text-white mb-6">📂 Categories</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {categories.map((cat) => (
        <a
          href={`/en/guides/#${cat.id}`}
          class="group flex items-start gap-4 rounded-xl border border-dark-border bg-dark-card p-5 hover:border-dark-accent transition-all"
        >
          <span class="text-3xl">{cat.icon}</span>
          <div>
            <h3 class="font-semibold text-white group-hover:text-dark-accent transition-colors">{cat.name}</h3>
            <p class="text-sm text-dark-muted mt-1">{cat.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="py-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="rounded-xl border border-dark-border bg-dark-card p-5 text-center">
        <div class="text-3xl font-bold text-dark-accent">50+</div>
        <div class="text-sm text-dark-muted mt-1">In-Depth Guides</div>
      </div>
      <div class="rounded-xl border border-dark-border bg-dark-card p-5 text-center">
        <div class="text-3xl font-bold text-dark-accent">S3</div>
        <div class="text-sm text-dark-muted mt-1">Latest Season</div>
      </div>
      <div class="rounded-xl border border-dark-border bg-dark-card p-5 text-center">
        <div class="text-3xl font-bold text-dark-accent">🌏</div>
        <div class="text-sm text-dark-muted mt-1">EN + VI</div>
      </div>
      <div class="rounded-xl border border-dark-border bg-dark-card p-5 text-center">
        <div class="text-3xl font-bold text-dark-accent">Free</div>
        <div class="text-sm text-dark-muted mt-1">100% Free</div>
      </div>
    </div>
  </section>
</BaseLayout>
