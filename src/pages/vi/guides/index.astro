---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides', ({ id }) => id.startsWith('vi/'));

const categoryMap: Record<string, { icon: string; name: string; guides: typeof allGuides }> = {
  combat: { icon: '⚔️', name: 'Chiến Đấu', guides: [] },
  heroes: { icon: '🦸', name: 'Tướng', guides: [] },
  buildings: { icon: '🏗️', name: 'Công Trình', guides: [] },
  gear: { icon: '🛡️', name: 'Trang Bị', guides: [] },
  resources: { icon: '💎', name: 'Tài Nguyên', guides: [] },
  seasons: { icon: '🏆', name: 'Mùa Giải', guides: [] },
  decorations: { icon: '🏛️', name: 'Trang Trí', guides: [] },
};

allGuides.forEach((guide) => {
  const cat = guide.data.category || 'combat';
  if (categoryMap[cat]) {
    categoryMap[cat].guides.push(guide);
  }
});
---

<BaseLayout title="Tất Cả Hướng Dẫn" lang="vi">
  <h1 class="text-3xl font-bold text-white mb-8">📚 Tất Cả Hướng Dẫn</h1>

  {Object.entries(categoryMap).map(([catId, cat]) => (
    cat.guides.length > 0 && (
      <section id={catId} class="mb-12">
        <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
          <span>{cat.icon}</span>
          <span>{cat.name}</span>
          <span class="text-sm font-normal text-dark-muted">({cat.guides.length})</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {cat.guides.sort((a, b) => a.data.order - b.data.order).map((guide) => {
            const slug = guide.id.replace('vi/', '');
            return (
              <a
                href={`/vi/guides/${slug}/`}
                class="group flex items-center gap-3 rounded-lg border border-dark-border bg-dark-card px-4 py-3 hover:border-dark-accent transition-all"
              >
                <span class="text-dark-accent">▸</span>
                <div>
                  <h3 class="font-medium text-white group-hover:text-dark-accent transition-colors text-sm">
                    {guide.data.title}
                  </h3>
                  {guide.data.description && (
                    <p class="text-xs text-dark-muted mt-0.5 line-clamp-1">{guide.data.description}</p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  ))}
</BaseLayout>
