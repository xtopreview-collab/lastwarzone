---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides', ({ id }) => id.startsWith('vi/'));

const groupedGuides = allGuides.reduce((acc, guide) => {
  const category = guide.data.category || 'Uncategorized';
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(guide);
  return acc;
}, {} as Record<string, typeof allGuides>);

const categoryOrder = [
  'General Guides',
  'Heroes Database',
  'Tools & Calculators',
  'Pre-Season 1',
  'Season 1',
  'Season 2',
  'Season 3',
  'Season 4',
  'Season 5',
  'Season 6'
];

const sortedCategories = Object.keys(groupedGuides).sort((a, b) => {
  const indexA = categoryOrder.indexOf(a);
  const indexB = categoryOrder.indexOf(b);
  if (indexA === -1 && indexB === -1) return a.localeCompare(b);
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});
---

<BaseLayout title="Thư Viện Hướng Dẫn - Last War Zone" description="Duyệt toàn bộ hướng dẫn, tier list và chiến thuật cho Last War: Survival Game." lang="vi">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-6xl font-black text-white tracking-tight mb-6">Thư Viện Chiến Thuật</h1>
      <p class="text-xl text-dark-muted max-w-3xl mx-auto">Khám phá {allGuides.length} bài hướng dẫn chi tiết, tier list tướng, và phân tích chiến thuật chuyên sâu cho Last War: Survival Game.</p>
    </div>

    <div class="space-y-20">
      {sortedCategories.map(category => (
        <section>
          <div class="border-b border-dark-border pb-4 mb-8">
            <h2 class="text-3xl font-bold text-white flex items-center gap-3">
              <span class="text-dark-accent">#</span> {category}
              <span class="text-sm font-normal text-dark-muted bg-dark-card px-3 py-1 rounded-full ml-3 border border-dark-border">
                {groupedGuides[category].length} Bài Viết
              </span>
            </h2>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {groupedGuides[category].map(guide => (
              <a href={`/vi/guides/${guide.id.replace('vi/', '').replace('.md', '').replace(/_/g, '-')}`} 
                 class="group block bg-dark-card border border-dark-border rounded-2xl p-6 hover:border-dark-accent hover:bg-dark-bg transition-all duration-300 shadow-sm hover:shadow-md hover:shadow-dark-accent/10 flex flex-col h-full relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-dark-accent to-blue-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                
                <h3 class="text-lg font-bold text-white group-hover:text-dark-accent transition-colors mb-3 line-clamp-2">
                  {guide.data.title}
                </h3>
                <p class="text-sm text-dark-muted line-clamp-3 mb-6 flex-grow">
                  {guide.data.description || 'Hướng dẫn và chiến thuật toàn tập cho Last War: Survival Game.'}
                </p>
                
                <div class="flex items-center justify-between text-xs font-medium mt-auto pt-4 border-t border-dark-border/50">
                  <span class="text-dark-accent">Đọc Bài &rarr;</span>
                  <span class="text-dark-muted">{guide.data.pubDate}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
      
      {allGuides.length < 10 && (
        <div class="mt-12 p-8 rounded-2xl border-2 border-dashed border-dark-border flex flex-col items-center justify-center text-center bg-dark-card/50">
          <div class="w-16 h-16 rounded-full bg-dark-accent/10 flex items-center justify-center text-3xl mb-4">🤖</div>
          <h3 class="text-xl font-bold text-white mb-2">Hệ Thống Đang Dịch Thuật</h3>
          <p class="text-dark-muted max-w-lg">
            Hệ thống AI của chúng tôi đang tiến hành biên dịch hàng loạt 250+ bài viết gốc từ tiếng Anh sang tiếng Việt. Các bài viết mới sẽ xuất hiện tại đây khi hoàn thành.
          </p>
          <a href="/en/guides/" class="mt-6 px-6 py-2 rounded-full bg-dark-accent text-white font-bold hover:bg-dark-accent-hover transition-colors">
            Xem Bản Gốc Tiếng Anh
          </a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
