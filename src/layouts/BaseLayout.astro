---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
}

const { title, description = 'Last War Survival Game Guide - Hướng dẫn chiến thuật', lang = 'vi', image = '/images/heroes/hero-tier-list-2026.webp' } = Astro.props;
const altLang = lang === 'vi' ? 'en' : 'vi';
const altPath = Astro.url.pathname.replace(`/${lang}/`, `/${altLang}/`);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} | LastWarZone`;
const ogImage = new URL(image, Astro.site).toString();

// Schema markup
const schemaData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "LastWarZone",
  "url": "https://lastwarzone.com",
  "description": "The ultimate Last War: Survival Game strategy guide",
  "inLanguage": [lang === 'vi' ? 'vi-VN' : 'en-US'],
  "publisher": {
    "@type": "Organization",
    "name": "LastWarZone",
    "url": "https://lastwarzone.com"
  }
});
---

<!DOCTYPE html>
<html lang={lang} class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Hreflang (self + alternate) -->
  <link rel="alternate" hreflang={lang === 'vi' ? 'vi' : 'en'} href={canonicalURL} />
  <link rel="alternate" hreflang={altLang} href={`https://lastwarzone.com${altPath}`} />
  <link rel="alternate" hreflang="x-default" href={`https://lastwarzone.com/en/${Astro.url.pathname.replace(/^\/(vi|en)\//, '')}`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="LastWarZone" />
  <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={schemaData} />

  <title>{fullTitle}</title>
</head>
<body class="min-h-screen bg-dark-bg text-dark-text font-sans antialiased">
  <header class="sticky top-0 z-50 border-b border-dark-border bg-dark-bg/80 backdrop-blur-lg">
    <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <!-- Logo -->
        <a href={`/${lang}/`} class="flex items-center gap-2">
          <span class="text-2xl">⚔️</span>
          <span class="text-xl font-bold text-white">LastWar<span class="text-dark-accent">Zone</span></span>
        </a>

        <!-- Nav Links -->
        <div class="hidden md:flex items-center gap-6">
          <a href={`/${lang}/guides/`} class="text-dark-muted hover:text-white transition-colors text-sm font-medium">
            {lang === 'vi' ? '📚 Hướng Dẫn' : '📚 Guides'}
          </a>
          <a href={`/${lang}/guides/#heroes`} class="text-dark-muted hover:text-white transition-colors text-sm font-medium">
            🏆 Tier List
          </a>
          <a href={`/${lang}/guides/#gear`} class="text-dark-muted hover:text-white transition-colors text-sm font-medium">
            {lang === 'vi' ? '🛡️ Trang Bị' : '🛡️ Gear'}
          </a>
        </div>

        <!-- Language Switcher + Mobile Menu -->
        <div class="flex items-center gap-3">
          <a
            href={altPath}
            class="flex items-center gap-1 rounded-lg border border-dark-border px-3 py-1.5 text-xs font-medium text-dark-muted hover:text-white hover:border-dark-accent transition-all"
          >
            {lang === 'vi' ? '🇬🇧 EN' : '🇻🇳 VI'}
          </a>

          <!-- Mobile hamburger -->
          <button id="mobile-menu-btn" class="md:hidden p-2 text-dark-muted hover:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden md:hidden pb-4">
        <div class="flex flex-col gap-2">
          <a href={`/${lang}/guides/`} class="text-dark-muted hover:text-white py-2 text-sm">
            {lang === 'vi' ? '📚 Hướng Dẫn' : '📚 Guides'}
          </a>
          <a href={`/${lang}/guides/#heroes`} class="text-dark-muted hover:text-white py-2 text-sm">
            🏆 Tier List
          </a>
          <a href={`/${lang}/guides/#gear`} class="text-dark-muted hover:text-white py-2 text-sm">
            {lang === 'vi' ? '🛡️ Trang Bị' : '🛡️ Gear'}
          </a>
        </div>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <slot />
  </main>

  <footer class="border-t border-dark-border mt-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="text-lg">⚔️</span>
          <span class="font-bold text-white">LastWar<span class="text-dark-accent">Zone</span></span>
        </div>
        <p class="text-dark-muted text-sm">
          {lang === 'vi'
            ? '© 2026 LastWarZone. Không liên kết với FunFly. Nội dung dùng cho mục đích giáo dục.'
            : '© 2026 LastWarZone. Not affiliated with FunFly. Content for educational purposes.'}
        </p>
      </div>
    </div>
  </footer>

  <script>
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
